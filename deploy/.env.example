# Copy to deploy/.env and fill in real values. deploy/.env is gitignored by
# the repo root .gitignore's `.env` / `.env.*` patterns — never commit it,
# and never bake real secrets into the image (they're passed at container
# start via --env-file / compose env_file, not COPY'd into any layer).
#
# See packages/facilitator/src/env.ts for the authoritative schema — this
# file documents the same variables the compose stack and platform deploys
# need.

# Razorpay TEST MODE only (rzp_test_...). Never live keys — this facilitator
# has never been audited for a real-money deployment.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# Facilitator boot secrets (fail-loud if absent). Any strong random string —
# generate with e.g. `openssl rand -hex 16`.
DASHBOARD_TOKEN=change-me-dashboard
ADMIN_TOKEN=change-me-admin

# Optional — powers POST /agent/select (goal-aware product pick behind the
# dashboard's "Run test purchase" button). Any OpenAI-compatible
# chat-completions endpoint. Omit any of the three and the facilitator falls
# back to a cheapest-in-budget pick (via:'cheapest' in the response) rather
# than failing.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Container-specific (not read by packages/facilitator/src/env.ts's
# schema directly as these names, but wired through by deploy/entrypoint.sh
# and Dockerfile ENV) ---

# Path to the SQLite DB file. Must point inside the mounted volume (/data in
# the provided Dockerfile/compose) or the ledger resets on every restart.
DB_PATH=/data/hundi.db

# Public-facing port the socat sidecar listens on inside the container (see
# deploy/entrypoint.sh for why the facilitator process itself can't be the
# thing bound to a network-reachable interface). This is the port you point
# Fly.io's [http_service].internal_port or Railway's target port at — not
# PORT below.
PUBLIC_PORT=8080

# The facilitator's own loopback-only bind port. Only relevant if you need
# to change it from the default (e.g. to avoid a collision) — the socat
# sidecar reads this same value to know where to forward to.
# PORT=8790

# Set to false only when running the demo store as its own compose service
# (see deploy/docker-compose.yml's `store` service under the `full-stack`
# profile) — leave it unset/true for the default single-container deploy.
# ENABLE_DEMO_STORE=true
