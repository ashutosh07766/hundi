# Razorpay TEST MODE only (rzp_test_...). Never live keys.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
# Facilitator boot secrets (fail-loud if absent). Any strong random string.
DASHBOARD_TOKEN=change-me-dashboard
ADMIN_TOKEN=change-me-admin
# Optional — authorizes ONLY the store-onboarding endpoint (never mandate
# approval). Set it if you want a buyer agent to scan a new store itself.
ONBOARD_TOKEN=change-me-onboard
# Optional — powers the facilitator's POST /agent/select (goal-aware product pick
# behind the dashboard's "Run test purchase" button). Any OpenAI-compatible
# chat-completions endpoint. Omit any of the three and the facilitator falls back
# to a cheapest-in-budget pick, reported as via:'cheapest' rather than failing.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
